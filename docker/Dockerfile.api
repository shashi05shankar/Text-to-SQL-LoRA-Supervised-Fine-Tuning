# CPU-only inference image. No CUDA, no training dependencies.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    T2S_ARTIFACTS_DIR=/artifacts \
    T2S_DATA_DIR=/data \
    # Cache Hub downloads on a volume so the 3 GB base model survives a container restart.
    HF_HOME=/hf-cache

WORKDIR /app

# Requirements first: this layer is cached across source edits, and installing torch is
# by far the slowest step in the build.
COPY docker/requirements-serving.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --no-cache-dir --no-deps -e .

RUN useradd --create-home --uid 1000 appuser \
    && mkdir -p /artifacts /data /hf-cache \
    && chown -R appuser /app /hf-cache
USER appuser

EXPOSE 8000

# The model loads lazily on the first /generate, so /health answers immediately -- a
# start_period long enough to cover a 1.5B load would otherwise mask real failures.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "text2sql_lora.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
